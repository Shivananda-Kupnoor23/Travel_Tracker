<mvc:View
    controllerName="travel.tracker.admin.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeed="sap.viz.ui5.controls.common.feeds"
    xmlns:unified="sap.ui.unified">

    <Page title="Travel Intelligence Dashboard" showNavButton="false" enableScrolling="true">
        <content>
            <VBox class="sapUiSmallMargin">

                <!-- Summary Cards -->
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                    <GenericTile header="Travelling Today" subheader="Active now"
                        press="onTileTravellingToday" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <TileContent>
                            <NumericContent value="{dash>/stats/travellingToday}" icon="sap-icon://flight" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="Upcoming 7 Days" subheader="Departing soon"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <TileContent>
                            <NumericContent value="{dash>/stats/upcoming7Days}" icon="sap-icon://date-time" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="Returning Today" subheader="Coming back"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <TileContent>
                            <NumericContent value="{dash>/stats/returningToday}" icon="sap-icon://undo" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="Currently Abroad" subheader="Outside India"
                        press="onTileAbroad" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <TileContent>
                            <NumericContent value="{dash>/stats/abroadNow}" icon="sap-icon://world" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="Countries" subheader="Active destinations"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <TileContent>
                            <NumericContent value="{dash>/stats/countriesCount}" icon="sap-icon://map" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="Domestic Today" subheader="Within India"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom" frameType="OneByOne">
                        <TileContent>
                            <NumericContent value="{dash>/stats/domesticToday}" icon="sap-icon://home" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="International" subheader="Abroad today"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom" frameType="OneByOne">
                        <TileContent>
                            <NumericContent value="{dash>/stats/internationalToday}" icon="sap-icon://globe" />
                        </TileContent>
                    </GenericTile>
                </HBox>

                <!-- Filters -->
                <Panel headerText="Filters" class="sapUiSmallMarginBottom">
                    <OverflowToolbar>
                        <SegmentedButton id="typeFilter" selectionChange="onFilterChange" selectedKey="All">
                            <items>
                                <SegmentedButtonItem key="All" text="All" />
                                <SegmentedButtonItem key="International" text="International" />
                                <SegmentedButtonItem key="Domestic" text="Domestic" />
                            </items>
                        </SegmentedButton>
                        <ToolbarSpacer />
                        <Select id="countryFilter" change="onFilterChange">
                            <core:Item key="" text="All Countries" />
                        </Select>
                        <Select id="deptFilter" change="onFilterChange">
                            <core:Item key="" text="All Departments" />
                            <core:Item key="Engineering" text="Engineering" />
                            <core:Item key="Sales" text="Sales" />
                            <core:Item key="HR" text="HR" />
                            <core:Item key="Marketing" text="Marketing" />
                            <core:Item key="Finance" text="Finance" />
                        </Select>
                        <Select id="statusFilter" change="onFilterChange">
                            <core:Item key="" text="All Status" />
                            <core:Item key="Planned" text="Planned" />
                            <core:Item key="Approved" text="Approved" />
                            <core:Item key="Travelling" text="Travelling" />
                            <core:Item key="Completed" text="Completed" />
                            <core:Item key="Cancelled" text="Cancelled" />
                        </Select>
                        <SearchField id="searchField" placeholder="Search employee..." search="onFilterChange" width="250px" />
                    </OverflowToolbar>
                </Panel>

                <!-- Two column layout: Chart + Calendar -->
                <HBox wrap="Wrap">
                    <!-- Country Distribution Chart -->
                    <VBox width="60%" class="sapUiSmallMarginEnd">
                        <Panel headerText="Country Distribution">
                            <viz:VizFrame id="countryChart" vizType="bar" height="300px" width="100%">
                                <viz:dataset>
                                    <vizData:FlattenedDataset data="{dash>/countryDistribution}">
                                        <vizData:dimensions>
                                            <vizData:DimensionDefinition name="Country" value="{dash>country}" />
                                        </vizData:dimensions>
                                        <vizData:measures>
                                            <vizData:MeasureDefinition name="Employees" value="{dash>count}" />
                                        </vizData:measures>
                                    </vizData:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <vizFeed:FeedItem uid="valueAxis" type="Measure" values="Employees" />
                                    <vizFeed:FeedItem uid="categoryAxis" type="Dimension" values="Country" />
                                </viz:feeds>
                            </viz:VizFrame>
                        </Panel>
                    </VBox>

                    <!-- Calendar -->
                    <VBox width="38%">
                        <Panel headerText="Calendar View">
                            <unified:Calendar id="travelCalendar" select="onDateSelect"
                                width="100%" />
                            <VBox id="calendarDetails" class="sapUiSmallMargin"
                                visible="{= ${dash>/selectedDateInfo/date} !== '' }">
                                <Title text="{dash>/selectedDateInfo/date}" level="H5" class="sapUiTinyMarginBottom" />
                                <HBox>
                                    <ObjectStatus text="Travelling: {dash>/selectedDateInfo/travelling}" state="Warning" class="sapUiSmallMarginEnd" />
                                    <ObjectStatus text="Returning: {dash>/selectedDateInfo/returning}" state="Success" class="sapUiSmallMarginEnd" />
                                    <ObjectStatus text="Departing: {dash>/selectedDateInfo/departing}" state="Information" />
                                </HBox>
                            </VBox>
                        </Panel>
                    </VBox>
                </HBox>

                <!-- World Map -->
                <Panel headerText="World Map - Travel Destinations" class="sapUiSmallMarginTop">
                    <core:HTML id="worldMapContainer" content="&lt;div id='worldMapSvg' style='width:100%;height:400px;background:#f0f4f8;border-radius:8px;position:relative;overflow:hidden'&gt;&lt;/div&gt;" afterRendering="onMapRendered" />
                </Panel>

                <!-- Currently Travelling Table -->
                <Panel headerText="Currently Travelling" class="sapUiSmallMarginTop">
                    <Table id="travelTable" items="{dash>/filteredTravels}" growing="true" growingThreshold="20">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="Employees ({= ${dash>/filteredTravels}.length})" />
                                <ToolbarSpacer />
                                <Button text="Refresh" icon="sap-icon://refresh" press="onRefresh" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column><Text text="Employee" /></Column>
                            <Column><Text text="Department" /></Column>
                            <Column><Text text="Type" /></Column>
                            <Column><Text text="Destination" /></Column>
                            <Column><Text text="From" /></Column>
                            <Column><Text text="Start" /></Column>
                            <Column><Text text="Return" /></Column>
                            <Column><Text text="Status" /></Column>
                            <Column><Text text="Actions" /></Column>
                        </columns>
                        <ColumnListItem type="Navigation" press="onCountryPress">
                            <Text text="{dash>employee/name}" />
                            <Text text="{dash>employee/department}" />
                            <ObjectStatus text="{dash>travelType}"
                                state="{= ${dash>travelType} === 'International' ? 'Information' : 'Success'}" />
                            <Text text="{= ${dash>travelType} === 'International' ? ${dash>toCountry} : ${dash>fromCity} + ' → ' + ${dash>toCity}}" />
                            <Text text="{= ${dash>travelType} === 'International' ? ${dash>fromCountry} : ''}" />
                            <Text text="{dash>startDate}" />
                            <Text text="{dash>endDate}" />
                            <ObjectStatus text="{dash>status}"
                                state="{= ${dash>status} === 'Planned' ? 'Information' : ${dash>status} === 'Approved' ? 'Success' : ${dash>status} === 'Travelling' ? 'Warning' : 'None'}" />
                            <HBox>
                                <Button icon="sap-icon://accept" type="Accept" tooltip="Approve"
                                    press="onApprove"
                                    visible="{= ${dash>status} === 'Planned'}"
                                    class="sapUiTinyMarginEnd" />
                                <Button icon="sap-icon://decline" type="Reject" tooltip="Reject"
                                    press="onReject"
                                    visible="{= ${dash>status} === 'Planned'}" />
                            </HBox>
                        </ColumnListItem>
                    </Table>
                </Panel>

            </VBox>
        </content>

        <!-- Floating Chatbot Button -->
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button id="chatbotBtn" icon="sap-icon://da" text="Travel Bot"
                    type="Emphasized" press="onOpenChatbot"
                    class="sapUiSmallMarginEnd" />
            </Toolbar>
        </footer>

    </Page>
</mvc:View>
