<mvc:View
    controllerName="travel.tracker.admin.controller.CountryDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page title="{viewModel>/country} - {viewModel>/count} Employees"
          showNavButton="true" navButtonPress="onNavBack">
        <content>
            <Table items="{viewModel>/travels}" growing="true">
                <headerToolbar>
                    <Toolbar>
                        <Title text="Employees in {viewModel>/country}" />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="Employee" /></Column>
                    <Column><Text text="Department" /></Column>
                    <Column><Text text="From" /></Column>
                    <Column><Text text="Start Date" /></Column>
                    <Column><Text text="Return Date" /></Column>
                    <Column><Text text="Purpose" /></Column>
                    <Column><Text text="Status" /></Column>
                </columns>
                <ColumnListItem>
                    <Text text="{viewModel>employee/name}" />
                    <Text text="{viewModel>employee/department}" />
                    <Text text="{viewModel>fromCountry}" />
                    <Text text="{viewModel>startDate}" />
                    <Text text="{viewModel>endDate}" />
                    <Text text="{viewModel>purpose}" />
                    <ObjectStatus text="{viewModel>status}"
                        state="{= ${viewModel>status} === 'Travelling' ? 'Warning' : ${viewModel>status} === 'Approved' ? 'Success' : 'Information'}" />
                </ColumnListItem>
            </Table>
        </content>
    </Page>
</mvc:View>
