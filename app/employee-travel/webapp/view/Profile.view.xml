<mvc:View
    controllerName="travel.tracker.employee.controller.Profile"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page title="My Profile" showNavButton="true" navButtonPress="onNavBack"
          backgroundDesign="List">
        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Profile Card -->
                <l:Grid defaultSpan="L6 M12 S12" class="sapUiSmallMarginBottom">

                    <!-- Left: Avatar + Info -->
                    <Panel backgroundDesign="Solid" class="sapUiSmallMarginBottom">
                        <VBox alignItems="Center" class="sapUiMediumMargin">
                            <Avatar id="profileAvatar" initials="" displaySize="XL"
                                backgroundColor="Accent6" class="sapUiMediumMarginBottom" />

                            <Title id="profileName" text="" level="H3" class="sapUiTinyMarginBottom" />
                            <ObjectStatus id="profileRole" text="" state="Information"
                                class="sapUiTinyMarginBottom" />
                            <Text id="profileLastLogin" text=""
                                class="sapUiTinyMarginBottom" />
                        </VBox>

                        <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
                            <f:SimpleForm editable="false"
                                layout="ResponsiveGridLayout"
                                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="4"
                                columnsXL="1" columnsL="1" columnsM="1">

                                <f:toolbar>
                                    <Toolbar>
                                        <Title text="Personal Information" level="H5" />
                                    </Toolbar>
                                </f:toolbar>

                                <Label text="Full Name" />
                                <Text id="infoName" text="" />

                                <Label text="Email" />
                                <Text id="infoEmail" text="" />

                                <Label text="Department" />
                                <Text id="infoDept" text="" />

                                <Label text="Manager" />
                                <Text id="infoManager" text="" />

                                <Label text="Employee ID" />
                                <Text id="infoId" text="" />
                            </f:SimpleForm>
                        </VBox>
                    </Panel>

                    <!-- Right: Travel Summary -->
                    <Panel backgroundDesign="Solid" class="sapUiSmallMarginBottom">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="My Travel Summary" level="H5" />
                            </Toolbar>
                        </headerToolbar>

                        <VBox class="sapUiSmallMargin">
                            <l:Grid defaultSpan="L6 M6 S6">
                                <GenericTile header="Total Trips" frameType="OneByOne"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                    <TileContent>
                                        <NumericContent id="totalTrips" value="0" icon="sap-icon://flight" />
                                    </TileContent>
                                </GenericTile>
                                <GenericTile header="Current" frameType="OneByOne"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                    <TileContent>
                                        <NumericContent id="currentTrips" value="0" icon="sap-icon://world"
                                            valueColor="Critical" />
                                    </TileContent>
                                </GenericTile>
                                <GenericTile header="Upcoming" frameType="OneByOne"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                    <TileContent>
                                        <NumericContent id="upcomingTrips" value="0" icon="sap-icon://date-time"
                                            valueColor="Good" />
                                    </TileContent>
                                </GenericTile>
                                <GenericTile header="Completed" frameType="OneByOne"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                    <TileContent>
                                        <NumericContent id="completedTrips" value="0" icon="sap-icon://complete"
                                            valueColor="Neutral" />
                                    </TileContent>
                                </GenericTile>
                            </l:Grid>
                        </VBox>

                        <!-- Countries visited -->
                        <VBox class="sapUiSmallMargin">
                            <Title text="Countries Visited" level="H5" class="sapUiSmallMarginBottom" />
                            <HBox id="countriesBox" wrap="Wrap" />
                        </VBox>

                        <!-- Recent travels -->
                        <VBox class="sapUiSmallMargin">
                            <Title text="Recent Travels" level="H5" class="sapUiSmallMarginBottom" />
                            <List id="recentTravelsList" noDataText="No travel history">
                                <StandardListItem
                                    title="{profile>destination}"
                                    description="{profile>startDate} - {profile>endDate}"
                                    icon="{= ${profile>travelType} === 'International' ? 'sap-icon://globe' : 'sap-icon://map'}"
                                    info="{profile>status}"
                                    infoState="{= ${profile>status} === 'Completed' ? 'None' : ${profile>status} === 'Travelling' ? 'Warning' : 'Success'}" />
                            </List>
                        </VBox>
                    </Panel>
                </l:Grid>

            </VBox>
        </content>
    </Page>
</mvc:View>
