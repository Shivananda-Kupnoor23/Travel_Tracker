{
  "name": "travel-tracker",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4",
    "@cap-js/hana": "^2",
    "@cap-js/sqlite": "^2",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "build:react": "cd react-ui && npm install && npm run build",
    "build:deploy": "npm run build:react && mkdir -p app/react-dist && cp -r react-ui/dist/* app/react-dist/",
    "build": "cds build --production"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "database": ":memory:"
        },
        "[production]": {
          "kind": "sqlite",
          "impl": "@cap-js/sqlite",
          "credentials": {
            "database": ":memory:"
          }
        }
      },
      "auth": {
        "[production]": {
          "kind": "dummy"
        }
      }
    }
  }
}
