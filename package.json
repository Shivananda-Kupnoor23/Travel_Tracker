{
  "name": "travel-tracker",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4",
    "@cap-js/hana": "^2"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "build:react": "cd react-ui && npm install && npm run build",
    "build:deploy": "npm run build:react && mkdir -p app/react-dist && cp -r react-ui/dist/* app/react-dist/",
    "build": "cds build --production"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sql"
      }
    }
  }
}
